+  const DESCENT_MIN = 196;
+  $effect(() => {
+    const slot = delveSlot;
+    if (!slot) return;
+    const fit = () => {
+      const cols = slot.querySelector<HTMLElement>('.delve-cols');
+      const finds = slot.querySelector<HTMLElement>('.finds-col');
+      if (!cols || !finds || innerWidth < 1100) {
+        slot.style.removeProperty('--descent-w');
+        return;
+      }
+      const room = slot.clientHeight;
+      // The finds' own height, not the row's they are stretched to: from their top to the end of their last line.
+      const used = () => (finds.lastElementChild as HTMLElement).getBoundingClientRect().bottom - finds.getBoundingClientRect().top;
+      const max = Math.round(cols.clientWidth * 0.58);
+      let w = DESCENT_MIN;
+      slot.style.setProperty('--descent-w', `${w}px`);
+      while (w < max && used() < room) {
+        w += 8;
+        slot.style.setProperty('--descent-w', `${w}px`);
+      }
+      if (used() > room && w > DESCENT_MIN) slot.style.setProperty('--descent-w', `${w - 8}px`);
+    };
+    fit();
+    const ro = new ResizeObserver(fit);
+    ro.observe(slot);
+    return () => ro.disconnect();
+  });
 
