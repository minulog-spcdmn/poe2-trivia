+        <span class="glyph" style:--i={i} style:animation-delay="{300 + i * 80}ms">{ch}</span>
+      {/each}
+    </div>
+  </section>
+
+  <section class="block">
+    <header><h2>Party</h2></header>
+    <ul class="chips">
+      {#if host}
